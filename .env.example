# Conexión MariaDB usada por src/database/data-source.ts y AppModule.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Secretos obligatorios: generar valores aleatorios privados antes de arrancar.
JWT_SECRET=
PDF_RENDER_SECRET=

# URL interna que consume el renderer PDF; PDF_RENDER_BASE_URL tiene prioridad.
PDF_RENDER_BASE_URL=http://localhost:3000
FRONTEND_INTERNAL_URL=http://localhost:3000

# Puerto HTTP y orígenes web permitidos separados por coma.
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Integración MariaDB: usar solo un esquema aislado con nombre que incluya test.
# RUN_DB_INTEGRATION=1
# DB_DATABASE=sterinova_phase2_test
