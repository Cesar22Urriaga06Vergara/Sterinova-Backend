# Conexión MariaDB usada por src/database/data-source.ts y AppModule.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=sterinova
DB_PASSWORD=replace-with-local-database-password
DB_DATABASE=sterinova

# Entorno y servidor HTTP.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Secretos obligatorios: generar valores aleatorios y privados antes de arrancar.
JWT_SECRET=replace-with-a-long-random-secret
PDF_RENDER_SECRET=replace-with-a-long-random-secret

# URL interna que consume el renderer PDF; PDF_RENDER_BASE_URL tiene prioridad.
PDF_RENDER_BASE_URL=http://localhost:3000
FRONTEND_INTERNAL_URL=http://localhost:3000
PDF_RENDER_TIMEOUT_MS=15000

# Almacenamiento local para documentos PDF y sellos.
PDF_STORAGE_PATH=./storage
CERTIFICATION_SEALS_PATH=./storage/sellos

# Administrador inicial; usado por `npm run start:dev` y `npm run bootstrap:admin`.
ADMIN_NAME=Admin Sterinova
ADMIN_EMAIL=admin@sterinova.local
ADMIN_PASSWORD=replace-with-a-unique-local-admin-password

# Opcional: fijar el sello de certificación activo cuando existe más de uno.
# ICONTEC_SELLO_ID=1

# Integración MariaDB: usar solo un esquema aislado con nombre que incluya test.
# RUN_DB_INTEGRATION=1
# DB_DATABASE=sterinova_test
